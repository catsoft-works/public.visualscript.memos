#VS-MemoName-Favorite,
#VS-MemoName-Dropdown {
    width: 19px;
    height: 18px;
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    background-color: var(--unity-colors-button-background);
    border-color: var(--unity-colors-button-border);
    border-width: 1px;
}

#VS-MemoName-Favorite {
    margin-left: 2px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

#VS-MemoName-Dropdown {
    border-left-width: 0;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

#VS-MemoName-Favorite:hover,
#VS-MemoName-Dropdown:hover {
    background-color: var(--unity-colors-button-background-hover);
}